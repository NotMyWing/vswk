<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<WarningsAsErrors>$(WarningsAsErrors);CS9057</WarningsAsErrors>
		<Version>0.2.2</Version>
		<VintageStoryPath Condition="'$(VintageStoryPath)' == ''">$(VINTAGE_STORY)</VintageStoryPath>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Epsitec.Symbolic.Analyzer" Version="1.14.14.2646" PrivateAssets="all" />
		<Reference Include="VintagestoryAPI" HintPath="$(VintageStoryPath)/VintagestoryAPI.dll" Private="false" />
		<Reference Include="VintagestoryLib" HintPath="$(VintageStoryPath)/VintagestoryLib.dll" Private="false" />
		<Reference Include="VSEssentials" HintPath="$(VintageStoryPath)/Mods/VSEssentials.dll" Private="false" />
		<Reference Include="VSSurvivalMod" HintPath="$(VintageStoryPath)/Mods/VSSurvivalMod.dll" Private="false" />
		<Reference Include="protobuf-net" HintPath="$(VintageStoryPath)/Lib/protobuf-net.dll" Private="false" />
		<Reference Include="0Harmony" HintPath="$(VintageStoryPath)/Lib/0Harmony.dll" Private="false" />
		<ModAsset Include="assets/**/*" />
	</ItemGroup>
	<Target Name="NameModAssembly" BeforeTargets="CoreCompile">
		<GetFileHash Files="@(Compile);$(MSBuildProjectFullPath)">
			<Output TaskParameter="Items" ItemName="ModSourceHash" />
		</GetFileHash>
		<WriteLinesToFile File="$(IntermediateOutputPath)mod-inputs.txt" Lines="@(ModSourceHash->'%(FileHash)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
		<GetFileHash Files="$(IntermediateOutputPath)mod-inputs.txt">
			<Output TaskParameter="Hash" PropertyName="ModBuildHash" />
		</GetFileHash>
		<ItemGroup>
			<IntermediateAssembly Remove="@(IntermediateAssembly)" />
			<IntermediateAssembly Include="$(IntermediateOutputPath)$(AssemblyName).$(ModBuildHash.Substring(0,16)).dll" />
		</ItemGroup>
	</Target>
	<Target Name="PackMod" AfterTargets="Build">
		<RemoveDir Directories="$(IntermediateOutputPath)mod" />
		<MakeDir Directories="$(IntermediateOutputPath)mod;dist" />
		<Copy SourceFiles="@(IntermediateAssembly);modinfo.json;modicon.png;LICENSE;THIRD_PARTY_NOTICES.md" DestinationFolder="$(IntermediateOutputPath)mod" />
		<Copy SourceFiles="@(ModAsset)" DestinationFiles="@(ModAsset->'$(IntermediateOutputPath)mod/%(Identity)')" />
		<ZipDirectory SourceDirectory="$(IntermediateOutputPath)mod" DestinationFile="dist/vintageknuckle-$(Version).zip" Overwrite="true" />
	</Target>
</Project>
